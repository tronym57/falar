                "ele, ela, você",
                "quer"
              ],
              [
                "nós",
                "queremos"
              ],
              [
                "eles, elas, vocês",
                "querem"
              ]
            ]
          },
          {
            "type": "examples",
            "items": [
              {
                "id": "u2-g04",
                "pt": "Queria um chá, por favor.",
                "en": "I'd like a tea, please."
              },
              {
                "id": "u2-g05",
