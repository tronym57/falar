        {
          "id": "u2-d1-01",
          "speaker": "E",
          "pt": "Bom dia! O que deseja?",
          "en": "Good morning! What would you like?"
        },
        {
          "id": "u2-d1-02",
          "speaker": "Y",
          "pt": "Bom dia. Queria um galão e um pastel de nata, por favor.",
          "en": "Good morning. I'd like a galão and a custard tart, please."
        },
        {
          "id": "u2-d1-03",
          "speaker": "E",
          "pt": "É para comer aqui ou para levar?",
          "en": "Is it to eat here or to take away?"
        },
        {
          "id": "u2-d1-04",
          "speaker": "Y",
          "pt": "É para comer aqui.",
          "en": "It's to eat here."
        },
        {
          "id": "u2-d1-05",
          "speaker": "E",
          "pt": "Mais alguma coisa?",
          "en": "Anything else?"
        },
        {
          "id": "u2-d1-06",
          "speaker": "Y",
          "pt": "Sim, uma água sem gás, por favor.",
          "en": "Yes, a still water, please."
        },
        {
          "id": "u2-d1-07",
          "speaker": "E",
          "pt": "Fresca ou natural?",
          "en": "Cold or room temperature?"
        },
        {
          "id": "u2-d1-08",
          "speaker": "Y",
          "pt": "Fresca, se faz favor.",
          "en": "Cold, please."
        },
        {
          "id": "u2-d1-09",
          "speaker": "E",
          "pt": "Muito bem. Mais alguma coisa?",
          "en": "Very good. Anything else?"
        },
        {
          "id": "u2-d1-10",
          "speaker": "Y",
          "pt": "Não, é tudo. Quanto é?",
          "en": "No, that's all. How much is it?"
        },
        {
          "id": "u2-d1-11",
          "speaker": "E",
          "pt": "São três euros.",
          "en": "That's three euros."
        },
        {
          "id": "u2-d1-12",
          "speaker": "Y",
          "pt": "Aqui tem. Obrigado!",
          "en": "Here you are. Thank you!"
        }
      ],
