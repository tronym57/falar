  "grammar": {
    "topics": [
      {
        "id": "u2-t1",
        "title": "O, a, um, uma: every noun has a gender",
        "sections": [
          {
            "type": "rule",
            "title": "Masculine or feminine",
            "text": "Every noun is masculine or feminine, and the little words before it follow: o and um for masculine, a and uma for feminine."
          },
          {
            "type": "table",
            "caption": "Articles",
            "head": [
              "",
              "masculine",
              "feminine"
            ],
            "rows": [
              [
                "the",
                "o café",
                "a torrada"
              ],
              [
                "a / an",
                "um café",
                "uma torrada"
              ],
              [
                "the (plural)",
                "os cafés",
                "as torradas"
              ]
            ]
          },
          {
            "type": "rule",
            "title": "A rule of thumb",
            "text": "Most nouns ending in -o are masculine, most ending in -a are feminine. Others you just learn: o chá, o leite, a sandes."
          },
          {
            "type": "examples",
            "items": [
              {
                "id": "u2-g01",
                "pt": "Um galão e uma torrada, por favor.",
                "en": "A galão and a toast, please."
              },
              {
                "id": "u2-g02",
                "pt": "O café está ótimo.",
                "en": "The coffee is great."
              },
              {
                "id": "u2-g03",
                "pt": "A água é fresca?",
                "en": "Is the water cold?"
              }
            ]
          },
          {
            "type": "tip",
            "text": "Learn every noun with its article: o leite, a água, o pão. Then you never have to guess."
          },
          {
            "type": "ep-note",
            "text": "In Portugal um café is a small espresso. For a big milky coffee, ask for um galão (glass) or uma meia de leite (cup)."
          }
        ],
