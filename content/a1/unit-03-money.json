      {
        "id": "u3-t2",
        "title": "Prices: custa, custam, são",
        "sections": [
          {
            "type": "rule",
            "title": "Custa or custam?",
            "text": "Custar (to cost) agrees with what you're buying: o pão custa, as laranjas custam."
          },
          {
            "type": "rule",
            "title": "É or são?",
            "text": "Saying a price: é for one euro, são for more than one: é um euro, são três euros."
          },
          {
            "type": "table",
            "caption": "Asking and answering",
            "head": [
              "Question",
              "Answer"
            ],
            "rows": [
              [
                "Quanto custa o pão?",
                "Custa um euro."
              ],
              [
                "Quanto custam as laranjas?",
                "Custam dois euros o quilo."
              ],
              [
                "Quanto é?",
                "São cinco euros e cinquenta."
              ]
            ]
          },
          {
            "type": "examples",
            "items": [
              {
                "id": "u3-g05",
                "pt": "Quanto custa a melancia?",
                "en": "How much is the watermelon?"
              },
              {
                "id": "u3-g06",
                "pt": "As sardinhas custam seis euros.",
                "en": "The sardines are six euros."
              },
              {
                "id": "u3-g07",
                "pt": "São doze euros e cinquenta cêntimos.",
                "en": "It's twelve euros fifty."
              }
            ]
          },
          {
            "type": "tip",
            "text": "Plurals: add -s after a vowel (laranja → laranjas), -es after r or z (flor → flores). Words in -ão change: pão → pães, limão → limões."
          }
        ],
