    {
      "title": "Ao telefone com a loja de surf",
      "en": "You call a surf shop to rent a board for Saturday.",
      "speakers": {
        "F": {
          "name": "Loja de surf",
          "voice": "raquel"
        },
        "Y": {
          "name": "You",
          "voice": "duarte",
          "me": true
        }
      },
      "lines": [
        {
          "id": "u3-d2-01",
          "speaker": "F",
          "pt": "Loja de surf, bom dia!",
          "en": "Surf shop, good morning!"
        },
        {
          "id": "u3-d2-02",
          "speaker": "Y",
          "pt": "Bom dia. Quanto custa o aluguer de uma prancha?",
          "en": "Good morning. How much does it cost to rent a board?"
        },
        {
          "id": "u3-d2-03",
          "speaker": "F",
          "pt": "São quinze euros por dia.",
          "en": "Fifteen euros a day."
        },
        {
          "id": "u3-d2-04",
          "speaker": "Y",
          "pt": "E um fato?",
          "en": "And a wetsuit?"
        },
        {
          "id": "u3-d2-05",
          "speaker": "F",
          "pt": "O fato custa dez euros.",
          "en": "The wetsuit is ten euros."
        },
        {
          "id": "u3-d2-06",
          "speaker": "Y",
          "pt": "Está bem. Posso reservar para sábado?",
          "en": "OK. Can I book for Saturday?"
        },
        {
          "id": "u3-d2-07",
          "speaker": "F",
          "pt": "Claro. Qual é o seu número de telemóvel?",
          "en": "Of course. What's your mobile number?"
        },
        {
          "id": "u3-d2-08",
          "speaker": "Y",
          "pt": "É o nove, um, dois, três, quatro, cinco, seis, sete, oito.",
          "en": "It's nine, one, two, three, four, five, six, seven, eight."
        },
        {
          "id": "u3-d2-09",
          "speaker": "F",
          "pt": "Perfeito. Até sábado!",
          "en": "Perfect. See you on Saturday!"
        },
        {
          "id": "u3-d2-10",
          "speaker": "Y",
          "pt": "Até sábado. Obrigado!",
          "en": "See you on Saturday. Thank you!"
        }
      ],
