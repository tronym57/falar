  "grammar": {
    "topics": [
      {
        "id": "u3-t1",
        "title": "Numbers 0–100",
        "sections": [
          {
            "type": "rule",
            "title": "How they're built",
            "text": "0 to 15 have their own words. 16 to 19 are ten-and-six and so on: dezasseis, dezassete, dezoito, dezanove. From 21: vinte e um, trinta e dois, with e (and) in between."
          },
          {
            "type": "table",
            "caption": "0 to 19",
            "head": [
              "0–9",
              "10–19"
            ],
            "rows": [
              [
