  "dialogues": [
    {
      "title": "Na banca da fruta",
      "en": "At a fruit stall in the Peniche market.",
      "speakers": {
        "V": {
          "name": "Vendedora",
          "voice": "raquel"
        },
        "Y": {
          "name": "You",
          "voice": "duarte",
          "me": true
        }
      },
      "lines": [
        {
          "id": "u3-d1-01",
          "speaker": "V",
          "pt": "Bom dia! O que vai ser?",
          "en": "Good morning! What will it be?"
        },
        {
          "id": "u3-d1-02",
          "speaker": "Y",
          "pt": "Bom dia. Quanto custam as laranjas?",
          "en": "Good morning. How much are the oranges?"
        },
        {
          "id": "u3-d1-03",
          "speaker": "V",
          "pt": "Custam dois euros o quilo.",
          "en": "Two euros a kilo."
        },
        {
          "id": "u3-d1-04",
          "speaker": "Y",
          "pt": "Queria dois quilos, por favor. E quanto custa a melancia?",
          "en": "I'd like two kilos, please. And how much is the watermelon?"
        },
        {
          "id": "u3-d1-05",
          "speaker": "V",
          "pt": "A melancia custa cinco euros.",
          "en": "The watermelon is five euros."
        },
        {
          "id": "u3-d1-06",
          "speaker": "Y",
          "pt": "Está bem, levo também.",
          "en": "OK, I'll take it too."
        },
        {
          "id": "u3-d1-07",
          "speaker": "V",
          "pt": "Então são nove euros.",
          "en": "So that's nine euros."
        },
        {
          "id": "u3-d1-08",
          "speaker": "Y",
          "pt": "Posso pagar com cartão?",
          "en": "Can I pay by card?"
        },
        {
          "id": "u3-d1-09",
          "speaker": "V",
          "pt": "Desculpe, só aceito dinheiro.",
          "en": "Sorry, I only take cash."
        },
        {
          "id": "u3-d1-10",
          "speaker": "Y",
          "pt": "Não faz mal. Tenho uma nota de vinte.",
          "en": "No problem. I have a twenty."
        },
        {
          "id": "u3-d1-11",
          "speaker": "V",
          "pt": "Aqui tem o troco: onze euros.",
          "en": "Here's your change: eleven euros."
        },
        {
          "id": "u3-d1-12",
          "speaker": "Y",
          "pt": "Obrigado. Bom dia!",
          "en": "Thank you. Have a good day!"
        }
      ],
