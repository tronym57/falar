  "grammar": {
    "topics": [
      {
        "id": "u0-t1",
        "title": "Obrigado or obrigada?",
        "sections": [
          {
            "type": "rule",
            "title": "It matches the speaker",
            "text": "\"Obrigado\" literally means \"obliged\". A man says obrigado, a woman says obrigada."
          },
          {
            "type": "table",
            "head": [
              "Who is speaking",
              "Says"
            ],
            "rows": [
              [
                "a man",
                "obrigado"
              ],
              [
                "a woman",
                "obrigada"
              ]
            ]
          },
          {
            "type": "examples",
            "items": [
              {
                "id": "u0-g01",
                "pt": "Obrigado!",
                "en": "Thank you! (said by a man)"
              },
              {
                "id": "u0-g02",
                "pt": "Obrigada!",
                "en": "Thank you! (said by a woman)"
              }
            ]
          },
          {
            "type": "tip",
            "text": "It never depends on who you thank. A woman thanking a man still says obrigada."
          }
        ],
