      "lines": [
        {
          "id": "u0-d1-01",
          "speaker": "F",
          "pt": "Bom dia!",
          "en": "Good morning!"
        },
        {
          "id": "u0-d1-02",
          "speaker": "Y",
          "pt": "Bom dia! Tudo bem?",
          "en": "Good morning! All good?"
        },
        {
          "id": "u0-d1-03",
          "speaker": "F",
          "pt": "Tudo bem, obrigada. E consigo?",
          "en": "All good, thank you. And you?"
        },
        {
          "id": "u0-d1-04",
          "speaker": "Y",
          "pt": "Tudo bem, obrigado.",
          "en": "All good, thank you."
        },
        {
          "id": "u0-d1-05",
          "speaker": "F",
          "pt": "Hoje está um dia bonito!",
          "en": "It's a beautiful day today!"
        },
        {
          "id": "u0-d1-06",
          "speaker": "Y",
          "pt": "Desculpe, não percebi. Pode repetir mais devagar, por favor?",
          "en": "Sorry, I didn't understand. Can you repeat more slowly, please?"
        },
        {
          "id": "u0-d1-07",
          "speaker": "F",
          "pt": "Hoje... está... um dia bonito.",
          "en": "Today... it's... a beautiful day."
        },
        {
          "id": "u0-d1-08",
          "speaker": "Y",
          "pt": "Ah, pois é! Está um dia muito bonito.",
          "en": "Ah, that's right! It's a very beautiful day."
        },
        {
          "id": "u0-d1-09",
          "speaker": "F",
          "pt": "Até logo!",
          "en": "See you later!"
        },
        {
