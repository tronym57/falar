{
  "id": "a1-u0",
  "n": 0,
  "title": "Survival kit",
  "scene": "Greetings, \"I don't understand\"",
  "dialogues": [
    {
      "title": "Na rua, de manhã",
      "en": "In the street, in the morning. You meet your neighbour, Dona Fátima.",
      "speakers": {
        "F": { "name": "Dona Fátima", "voice": "raquel" },
        "Y": { "name": "You", "voice": "duarte" }
      },
      "lines": [
        { "id": "u0-d1-01", "speaker": "F", "pt": "Bom dia!", "en": "Good morning!" },
        { "id": "u0-d1-02", "speaker": "Y", "pt": "Bom dia! Tudo bem?", "en": "Good morning! All good?" },
        { "id": "u0-d1-03", "speaker": "F", "pt": "Tudo bem, obrigada. E consigo?", "en": "All good, thank you. And you?" },
        { "id": "u0-d1-04", "speaker": "Y", "pt": "Tudo bem, obrigado.", "en": "All good, thank you." },
        { "id": "u0-d1-05", "speaker": "F", "pt": "Hoje está um dia bonito!", "en": "It's a beautiful day today!" },
        { "id": "u0-d1-06", "speaker": "Y", "pt": "Desculpe, não percebi. Pode repetir mais devagar, por favor?", "en": "Sorry, I didn't understand. Can you repeat more slowly, please?" },
        { "id": "u0-d1-07", "speaker": "F", "pt": "Hoje... está... um dia bonito.", "en": "Today... it's... a beautiful day." },
        { "id": "u0-d1-08", "speaker": "Y", "pt": "Ah, pois é! Está um dia muito bonito.", "en": "Ah, that's right! It's a very beautiful day." },
        { "id": "u0-d1-09", "speaker": "F", "pt": "Até logo!", "en": "See you later!" },
        { "id": "u0-d1-10", "speaker": "Y", "pt": "Até logo, bom dia!", "en": "See you later, have a good day!" }
      ]
    },
    {
      "title": "No supermercado",
      "en": "At the supermarket checkout. The cashier asks you something.",
      "speakers": {
        "C": { "name": "Cashier", "voice": "raquel" },
        "Y": { "name": "You", "voice": "duarte" }
      },
      "lines": [
        { "id": "u0-d2-01", "speaker": "C", "pt": "Boa tarde. Tem cartão de cliente?", "en": "Good afternoon. Do you have a loyalty card?" },
        { "id": "u0-d2-02", "speaker": "Y", "pt": "Desculpe, não percebi. Fala inglês?", "en": "Sorry, I didn't understand. Do you speak English?" },
        { "id": "u0-d2-03", "speaker": "C", "pt": "Um bocadinho. Cartão de cliente... tem?", "en": "A little bit. Loyalty card... do you have one?" },
        { "id": "u0-d2-04", "speaker": "Y", "pt": "Ah, não, não tenho. Obrigado.", "en": "Ah, no, I don't have one. Thank you." },
        { "id": "u0-d2-05", "speaker": "C", "pt": "Quer saco?", "en": "Do you want a bag?" },
        { "id": "u0-d2-06", "speaker": "Y", "pt": "Não, obrigado.", "en": "No, thank you." },
        { "id": "u0-d2-07", "speaker": "C", "pt": "Pronto. Obrigada, boa tarde!", "en": "There you go. Thank you, have a good afternoon!" },
        { "id": "u0-d2-08", "speaker": "Y", "pt": "Obrigado, igualmente!", "en": "Thank you, you too!" }
      ]
    }
  ],
  "phrases": [
    { "id": "u0-p01", "pt": "Bom dia", "en": "Good morning", "note": "Until about lunchtime." },
    { "id": "u0-p02", "pt": "Boa tarde", "en": "Good afternoon", "note": "From lunch until it gets dark." },
    { "id": "u0-p03", "pt": "Boa noite", "en": "Good evening / good night", "note": "After dark, both hello and goodbye." },
    { "id": "u0-p04", "pt": "Olá", "en": "Hello", "note": "Casual hello. \"Oi\" is Brazilian." },
    { "id": "u0-p05", "pt": "Tudo bem?", "en": "All good? / How are you?" },
    { "id": "u0-p06", "pt": "Tudo bem, obrigado.", "en": "All good, thank you.", "note": "Women say \"obrigada\"." },
    { "id": "u0-p07", "pt": "Por favor", "en": "Please" },
    { "id": "u0-p08", "pt": "De nada", "en": "You're welcome" },
    { "id": "u0-p09", "pt": "Desculpe", "en": "Sorry / Excuse me", "note": "Polite form. With friends: \"desculpa\"." },
    { "id": "u0-p10", "pt": "Com licença", "en": "Excuse me (to get past)" },
    { "id": "u0-p11", "pt": "Não percebi.", "en": "I didn't understand.", "note": "Portugal uses \"perceber\", not \"entender\", in everyday speech." },
    { "id": "u0-p12", "pt": "Pode repetir, por favor?", "en": "Can you repeat, please?" },
    { "id": "u0-p13", "pt": "Mais devagar, por favor.", "en": "More slowly, please." },
    { "id": "u0-p14", "pt": "Como se diz isto em português?", "en": "How do you say this in Portuguese?" },
    { "id": "u0-p15", "pt": "Fala inglês?", "en": "Do you speak English?" },
    { "id": "u0-p16", "pt": "Ainda não falo bem português.", "en": "I don't speak Portuguese well yet." },
    { "id": "u0-p17", "pt": "Pois é.", "en": "That's right. / Indeed.", "note": "Very common filler in Portugal." },
    { "id": "u0-p18", "pt": "Até logo!", "en": "See you later!" },
    { "id": "u0-p19", "pt": "Até amanhã!", "en": "See you tomorrow!" },
    { "id": "u0-p20", "pt": "Igualmente.", "en": "Likewise. / You too." }
  ],
