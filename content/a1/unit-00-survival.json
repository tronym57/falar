      {
        "id": "u0-t2",
        "title": "Saying \"you\": tu or polite",
        "sections": [
          {
            "type": "rule",
            "title": "Tu: friends and peers",
            "text": "Use tu with friends, people your age, kids and in the surf lineup. The verb ends in -s."
          },
          {
            "type": "rule",
            "title": "Polite: everyone else",
            "text": "With strangers, older people and shop staff, drop the word for \"you\" and use the verb without -s."
          },
          {
            "type": "table",
            "caption": "Same question, two ways",
            "head": [
              "English",
              "To a friend (tu)",
              "Polite"
            ],
            "rows": [
              [
                "Can you repeat?",
                "Podes repetir?",
                "Pode repetir?"
              ],
              [
                "Do you speak English?",
                "Falas inglês?",
                "Fala inglês?"
              ],
              [
                "Do you want a bag?",
                "Queres um saco?",
                "Quer um saco?"
              ]
            ]
          },
          {
            "type": "rule",
            "title": "Extra polite",
            "text": "Add o senhor (to a man) or a senhora (to a woman) before the verb."
          },
          {
            "type": "examples",
            "items": [
              {
                "id": "u0-g03",
                "pt": "Podes repetir?",
                "en": "Can you repeat? (to a friend)"
              },
              {
                "id": "u0-g04",
                "pt": "Pode repetir?",
                "en": "Can you repeat? (polite)"
              },
              {
                "id": "u0-g05",
                "pt": "O senhor fala inglês?",
                "en": "Do you speak English, sir?"
              },
              {
                "id": "u0-g06",
                "pt": "Falas inglês?",
                "en": "Do you speak English? (to a friend)"
              },
              {
                "id": "u0-g07",
                "pt": "A senhora quer um saco?",
                "en": "Do you want a bag, madam?"
              }
            ]
          },
          {
            "type": "tip",
            "text": "When unsure, use the polite form without a pronoun. You'll never sound rude."
          },
          {
            "type": "ep-note",
            "text": "In Brazil \"você\" is the normal word for \"you\". In Portugal it can sound distant or even rude, so skip it: tu with friends, the polite verb form with everyone else."
          }
        ],
