{
  "id": "a1-u1",
  "n": 1,
  "title": "Meeting people",
  "scene": "Beach car park in Baleal",
  "dialogues": [
    {
      "title": "No parque do Baleal",
      "en": "At the beach car park in Baleal. A surfer your age starts chatting.",
      "speakers": {
        "I": {
          "name": "Inês",
          "voice": "raquel"
        },
        "Y": {
          "name": "You",
          "voice": "duarte",
          "me": true
        }
      },
      "lines": [
        {
          "id": "u1-d1-01",
          "speaker": "I",
          "pt": "Olá! Vais para a água?",
          "en": "Hi! Are you going in the water?"
        },
        {
          "id": "u1-d1-02",
          "speaker": "Y",
          "pt": "Vou, sim! As ondas estão boas hoje.",
          "en": "Yes, I am! The waves are good today."
        },
        {
          "id": "u1-d1-03",
          "speaker": "I",
          "pt": "Pois estão. Como te chamas?",
          "en": "They are. What's your name?"
        },
        {
          "id": "u1-d1-04",
          "speaker": "Y",
          "pt": "Chamo-me Patrick. E tu?",
          "en": "My name is Patrick. And you?"
        },
        {
          "id": "u1-d1-05",
          "speaker": "I",
          "pt": "Eu sou a Inês. Muito prazer!",
          "en": "I'm Inês. Nice to meet you!"
        },
        {
          "id": "u1-d1-06",
          "speaker": "Y",
          "pt": "Muito prazer.",
          "en": "Nice to meet you."
        },
        {
          "id": "u1-d1-07",
          "speaker": "I",
          "pt": "De onde és?",
          "en": "Where are you from?"
        },
        {
          "id": "u1-d1-08",
          "speaker": "Y",
          "pt": "Sou da Alemanha. E tu, és daqui?",
          "en": "I'm from Germany. And you, are you from here?"
        },
        {
          "id": "u1-d1-09",
          "speaker": "I",
          "pt": "Sou de Lisboa, mas moro em Peniche.",
          "en": "I'm from Lisbon, but I live in Peniche."
        },
        {
          "id": "u1-d1-10",
          "speaker": "Y",
          "pt": "Eu também moro aqui perto.",
          "en": "I live nearby too."
        },
        {
          "id": "u1-d1-11",
          "speaker": "I",
          "pt": "Fixe! Então até já, na água!",
          "en": "Cool! See you in a bit, in the water!"
        },
        {
          "id": "u1-d1-12",
          "speaker": "Y",
          "pt": "Até já!",
          "en": "See you in a bit!"
        }
      ],
      "questions": [
        {
          "id": "u1-d1-q1",
          "q": "Where is Inês from?",
          "options": [
            "Lisbon",
            "Peniche",
            "Germany",
            "Baleal"
          ],
          "answer": 0
        },
        {
          "id": "u1-d1-q2",
          "q": "Where does Inês live?",
          "options": [
            "In Peniche",
            "In Lisbon",
            "In Germany",
            "In Baleal"
          ],
          "answer": 0
        },
        {
          "id": "u1-d1-q3",
          "q": "What are they both about to do?",
          "options": [
            "Go surfing",
            "Have a coffee",
            "Go home",
            "Drive to Lisbon"
          ],
          "answer": 0
        }
      ]
    },
    {
      "title": "Na esplanada",
      "en": "On a café terrace. An older lady asks for the free chair at your table.",
      "speakers": {
        "G": {
          "name": "Dona Graça",
          "voice": "raquel"
        },
        "Y": {
          "name": "You",
          "voice": "duarte",
          "me": true
        }
      },
      "lines": [
        {
          "id": "u1-d2-01",
          "speaker": "G",
          "pt": "Bom dia. Desculpe, esta cadeira está livre?",
          "en": "Good morning. Excuse me, is this chair free?"
        },
        {
          "id": "u1-d2-02",
          "speaker": "Y",
          "pt": "Está, sim. Faça favor.",
          "en": "Yes, it is. Go ahead."
        },
        {
          "id": "u1-d2-03",
          "speaker": "G",
          "pt": "Obrigada. O senhor não é português, pois não?",
          "en": "Thank you. You're not Portuguese, are you?"
        },
        {
          "id": "u1-d2-04",
          "speaker": "Y",
          "pt": "Não, sou alemão. Moro aqui perto.",
          "en": "No, I'm German. I live nearby."
        },
        {
          "id": "u1-d2-05",
          "speaker": "G",
          "pt": "Que bom! E fala muito bem português.",
          "en": "How nice! And you speak Portuguese very well."
        },
        {
          "id": "u1-d2-06",
          "speaker": "Y",
          "pt": "Obrigado, mas ainda estou a aprender.",
          "en": "Thank you, but I'm still learning."
        },
        {
          "id": "u1-d2-07",
          "speaker": "G",
          "pt": "Eu chamo-me Graça. Muito prazer.",
          "en": "My name is Graça. Pleased to meet you."
        },
        {
          "id": "u1-d2-08",
          "speaker": "Y",
          "pt": "Muito prazer, Dona Graça. Eu sou o Patrick.",
          "en": "Pleased to meet you, Dona Graça. I'm Patrick."
        },
        {
          "id": "u1-d2-09",
          "speaker": "G",
          "pt": "Então, tenha um bom dia!",
          "en": "Well then, have a good day!"
        },
        {
          "id": "u1-d2-10",
          "speaker": "Y",
          "pt": "Igualmente!",
          "en": "You too!"
        }
      ],
      "questions": [
        {
          "id": "u1-d2-q1",
          "q": "What does Dona Graça ask first?",
          "options": [
            "If the chair is free",
            "Where you are from",
            "What your name is",
            "If you speak English"
          ],
          "answer": 0
        },
        {
          "id": "u1-d2-q2",
          "q": "What nationality are you in the dialogue?",
          "options": [
            "German",
