  "grammar": {
    "topics": [
      {
        "id": "u1-t1",
        "title": "Ser: to be (who you are)",
        "sections": [
          {
            "type": "rule",
            "title": "Identity",
            "text": "Ser is for who or what you are: your name, nationality, where you're from, your job."
          },
          {
            "type": "table",
            "caption": "ser, present",
            "head": [
              "Person",
              "ser"
            ],
            "rows": [
              [
                "eu (I)",
                "sou"
              ],
              [
                "tu (you, friend)",
                "és"
              ],
              [
                "ele, ela, você (he, she, you polite)",
                "é"
              ],
              [
                "nós (we)",
                "somos"
              ],
              [
                "eles, elas, vocês (they, you all)",
                "são"
              ]
            ]
          },
          {
            "type": "examples",
            "items": [
              {
                "id": "u1-g01",
                "pt": "Sou alemão.",
                "en": "I'm German."
              },
              {
                "id": "u1-g02",
                "pt": "És de Lisboa?",
                "en": "Are you from Lisbon? (to a friend)"
              },
              {
                "id": "u1-g03",
                "pt": "A Inês é de Lisboa.",
                "en": "Inês is from Lisbon."
              },
              {
                "id": "u1-g04",
                "pt": "Somos amigos.",
                "en": "We're friends."
              }
            ]
          },
          {
            "type": "tip",
            "text": "Ser de + place: sou de Lisboa. With countries, de joins the article: sou da Alemanha (de + a), sou do Reino Unido (de + o), sou dos Estados Unidos (de + os)."
          },
          {
            "type": "ep-note",
            "text": "You'll often hear the pronoun dropped: Sou alemão, not Eu sou alemão. The verb ending already says who it is."
          }
        ],
